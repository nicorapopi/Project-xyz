{
  "identifier": "workspace",
  "description": "Local data, clipboard writes, and user-initiated folder and link opening",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "clipboard-manager:allow-write-text",
    "opener:default"
  ]
}
